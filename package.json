{
  "name": "@nicia-ai/typegraph-do-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo: TypeGraph turns one Cloudflare Durable Object class into a graph database per tenant — agent memory, Zanzibar-lite authz, and a personal knowledge graph, each with its own tenancy axis.",
  "license": "MIT",
  "author": {
    "name": "Nicia AI, Inc.",
    "email": "paul@nicia.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicia-ai/cf-do-typegraph.git"
  },
  "homepage": "https://github.com/nicia-ai/cf-do-typegraph#readme",
  "bugs": "https://github.com/nicia-ai/cf-do-typegraph/issues",
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  },
  "keywords": [
    "typegraph",
    "graph-database",
    "cloudflare-workers",
    "durable-objects",
    "multitenancy",
    "knowledge-graph"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wrangler types",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@nicia-ai/typegraph": "^0.73.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.18.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
